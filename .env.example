# Все переменные опциональны: пустое значение включает честную заглушку
# вместо падения (VideoSlot без источника, неактивная кнопка со ссылкой).

# Четыре слота видео практикума (SPEC.md §5.1). Видео 1 разрезано
# интерактивной паузой экрана 3 на два РАЗНЫХ куска записи: 1A — до выбора
# покупателя (экран 2), 1B — разбор после (экран 4). Общая переменная на обе
# половины заставила бы человека, только что выбравшего покупателя, увидеть
# то же видео с начала — поэтому у них разные слоты, хотя кодовое слово
# ФОРМУЛА на экране 5 общее для видео 1 целиком.
VITE_VIDEO_1A_URL=
VITE_VIDEO_1B_URL=
VITE_VIDEO_2_URL=
VITE_VIDEO_3_URL=

# Ссылки на ассистентов, оплату и поддержку (SPEC.md §5.2)
VITE_ASSISTANT_AUDIENCE_URL=
VITE_ASSISTANT_OFFER_URL=
VITE_CHECKOUT_URL=
VITE_SUPPORT_URL=
