# Все переменные опциональны. Пустое значение включает честную заглушку:
# слот видео показывает «материал пока не подключён», внешняя кнопка становится
# неактивной с подписью. Воронка проходима до конца при полностью пустом файле.
#
# В продакшене значения задаются не здесь, а в настройках репозитория:
# Settings → Secrets and variables → Actions → Variables. После изменения
# переменной нужно перезапустить workflow Deploy — значения подставляются
# на сборке.

# Три видео практикума (docs/SPEC.md §3.5). Пока не сняты.
VITE_VIDEO_1_URL=
VITE_VIDEO_2_URL=
VITE_VIDEO_3_URL=

# GPT-ассистенты: ссылка ведёт в чат с готовым ассистентом наружу.
VITE_ASSISTANT_AUDIENCE_URL=
VITE_ASSISTANT_OFFER_URL=

# Страница, собранная в третьем уроке. По ней можно потыкать — это главное
# доказательство обещания «за вечер». Появится вместе с записью.
VITE_LANDING_DEMO_URL=

# Оплата практикума за 3 990 ₽. Позже — ссылка Продамуса.
VITE_CHECKOUT_URL=

# Поддержка.
VITE_SUPPORT_URL=
